    "patch": {
      "file": "patch.nrm",
      "mod_id": "aki_starter_kit"
    },
    "codes": {
      "file": "codes.txt",
      "format": "aki-codes",
      "rom": "nomercy-rev1"
    },
    "rt": {
      "lights": "rt_lights.json"
    },
    "saves": [
      {
        "file": "saves/wwf.nomercy.us.bin",
